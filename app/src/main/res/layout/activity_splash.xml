<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_screen">

    <!-- Center Logo & Branding Container -->
    <LinearLayout
        android:id="@+id/layoutSplashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo with Halo Glow -->
        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="150dp">

            <!-- Soft Radial White Glow -->
            <View
                android:id="@+id/viewGlow"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_logo_glow" />

            <!-- Concept 02 Logo Graphic -->
            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:contentDescription="Expense Tracker Logo"
                android:src="@drawable/ic_logo_concept2" />
        </FrameLayout>

        <!-- App Name -->
        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.02"
            android:text="Expense Tracker"
            android:textColor="#1E293B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Subtitle / Tagline -->
        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.05"
            android:text="SMART • MINIMAL • SECURE"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom Version Info -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Version 1.0"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
