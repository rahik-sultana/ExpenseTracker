        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Bottom Horizontal Bar (E Bottom) -->
    <path
        android:pathData="M35,70 L65,70"
        android:strokeWidth="6.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Central Accent Node / Gem -->
    <path
        android:pathData="M50,45.5 A4.5,4.5 0 1,1 49.99,45.5 Z"
        android:fillColor="#818CF8" />

</vector>
